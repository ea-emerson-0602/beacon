# Copy this file to .env and fill in your own values.

# Postgres connection string the API uses at runtime.
# Docker Compose default (docker compose up -d from the project root):
DATABASE_URL="postgresql://beacon:beacon@localhost:5432/beacon?schema=public"

# Aiven (production) — copy Service URI from the Overview page. It already
# includes sslmode=require. If you created a Connection pool, use that URI
# here and add pgbouncer=true:
# DATABASE_URL="postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require"
# DATABASE_URL="postgres://avnadmin:PASSWORD@HOST:POOL_PORT/POOL_NAME?sslmode=require&pgbouncer=true"

# Connection string Prisma CLI uses for migrations. This must be a DIRECT,
# non-pooled connection, and it has no default — leave it equal to DATABASE_URL
# unless your database sits behind a pooler.
DIRECT_URL="postgresql://beacon:beacon@localhost:5432/beacon?schema=public"
# Aiven — always the Overview Service URI (not the pooler):
# DIRECT_URL="postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require"

# Optional. Leave empty to run webhook delivery from the Postgres outbox only.
# With Redis set, deliveries also run through a BullMQ queue with backoff.
REDIS_URL=""

# Sign your own. Any long random string: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Set to "true" only when serving over HTTPS.
COOKIE_SECURE="false"

# Optional. Without these, password-reset emails are logged and the local
# forgot-password page shows the reset link so you can finish the flow.
RESEND_API_KEY=""
MAIL_FROM="Beacon <noreply@beacon.dev>"
